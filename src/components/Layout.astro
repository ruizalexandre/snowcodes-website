---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import { ui } from '../i18n.js';
import '../styles/global.css';

// path: this page's path without locale prefix ('' for home), used for the language switcher and hreflang.
const { title = 'SNOWCODES', path = '' } = Astro.props;
const lang = Astro.currentLocale ?? 'fr';
const t = ui[lang];
// Section anchors live on the home page: same-page on home, prefixed elsewhere.
const home = path ? getRelativeLocaleUrl(lang) : '';
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{title}</title>
        <meta name="description" content={t.description}>
        <meta name="theme-color" content="#000000">
        {Object.keys(ui).map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l, path)}>)}
        <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('fr', path)}>
        <link rel="icon" type="image/svg+xml"
            href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23000'/%3E%3Crect x='22' y='22' width='56' height='56' rx='6' fill='%23FF5A00'/%3E%3C/svg%3E">
        <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    </head>

    <body>
        <!-- Header -->
        <header id="header">
            <div class="wrap">
                <a href={home || '#'} class="logo" aria-label={t.home}>
                    <picture>
                        <source srcset="/assets/web/logo.webp" type="image/webp">
                        <img src="/assets/web/logo.png" alt="SNOWCODES" width="1200" height="530">
                    </picture>
                </a>
                <ul class="menu">
                    <li><a href={`${home}#services`}>{t.nav.services}</a></li>
                    <li><a href={`${home}#specs`}>{t.nav.specs}</a></li>
                    <li><a href={`${home}#manifesto`}>{t.nav.manifesto}</a></li>
                    <li><a href={getRelativeLocaleUrl(lang, 'showcase')} aria-current={path === 'showcase' ? 'page' : undefined}>{t.nav.showcase}</a></li>
                    <li><a href={`${home}#contact`}>{t.nav.contact}</a></li>
                </ul>
                <div class="menu-right">
                    <nav class="lang" aria-label={t.language}>
                        {Object.entries(ui).map(([l, u]) => (
                            <a href={getRelativeLocaleUrl(l, path)} hreflang={l} lang={l} aria-label={u.name}
                                aria-current={l === lang ? 'page' : undefined}>{l.toUpperCase()}</a>
                        ))}
                    </nav>
                    <a href={`${home}#contact`} class="pill"><i></i><span>{t.available}</span></a>
                </div>
            </div>
        </header>

        <main>
            <slot />
        </main>

        <footer>
            <div class="wrap">
                <span>Snowcodes &copy; <span id="year">{new Date().getFullYear()}</span></span>
                <a href={`${home}#services`}>{t.nav.services}</a>
                <a href={`${home}#specs`}>{t.nav.specs}</a>
                <a href={getRelativeLocaleUrl(lang, 'showcase')}>{t.nav.showcase}</a>
                <a href={`${home}#contact`}>{t.nav.contact}</a>
                <a href={getRelativeLocaleUrl(lang, 'mentions-legales')}>{t.legal.title}</a>
                <span>Code · Create · Explore</span>
            </div>
        </footer>

        <script>
            import '../scripts/site.js';
        </script>
    </body>
</html>
